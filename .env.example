# Placeholders only. Never commit real secrets.
ASTER_GATEWAY_PORT=4310
ASTER_GROUND_PORT=4320
ASTER_BIND_HOST=127.0.0.1
# Required only when binding to a non-loopback host:
ASTER_API_TOKEN=
# Comma-separated browser origins allowed to call the APIs. Default: the ASTER web app on loopback
# (http://127.0.0.1:5173, http://localhost:5173, http://127.0.0.1:4173, http://localhost:4173). Setting this replaces the default.
ASTER_ALLOWED_ORIGINS=
# Comma-separated extra Host header names accepted (needed when binding to 0.0.0.0 or behind a reverse proxy).
ASTER_ALLOWED_HOSTS=
# Where the gateway reaches the ground process. A token is only sent over https, or over http to a loopback host.
ASTER_GROUND_URL=http://127.0.0.1:4320
# Bearer token of the ground process (its ASTER_API_TOKEN), when ground requires one:
ASTER_GROUND_TOKEN=
# Directory for the local SQLite databases (gateway.sqlite, ground.sqlite). Keep it out of version control.
ASTER_DATA_DIR=.aster-data
# Simulated scenario and seed run by the gateway (simulated data only):
ASTER_SCENARIO=SIM-12
ASTER_SEED=7
